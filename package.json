{
  "name": "korona-proxy",
  "productName": "Korona Proxy",
  "version": "0.1.3",
  "description": "Free proxy manager — import lists from GitHub, check latency, system-wide connect.",
  "main": "main.js",
  "license": "MIT",
  "author": "Korona Proxy <romanshutrov@gmail.com>",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.koronaproxy.client",
    "productName": "Korona Proxy",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": {
      "icon": "app/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64", "ia32"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KoronaProxy-Setup-${arch}.exe"
    },
    "linux": {
      "icon": "app/icon.png",
      "category": "Network",
      "artifactName": "KoronaProxy-${arch}.${ext}",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "protocols": [
      { "name": "Korona Proxy", "schemes": ["korona"] }
    ]
  }
}
